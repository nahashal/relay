# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=
GEMINI_MODEL=

# Comma separated, tried in order when the primary is overloaded, out of
# quota or missing. Run scripts/check_setup.py - it probes and prints a
# line you can paste here, because being LISTED is not being USABLE.
GEMINI_FALLBACK_MODELS=

# OAuth client downloaded from Google Cloud Console, for the TEST account only
GOOGLE_CLIENT_SECRETS=credentials.json

# "mock" uses fixtures and sends nothing. "live" talks to the test Google
# account and really sends. There is no automatic fallback either way: a
# misspelt value is an error, not a quiet mock. See GOING-LIVE.md.
RELAY_BACKEND=mock

# Required when RELAY_BACKEND=live: the test account RELAY acts as. Every plan
# is addressed relative to this ("me" in a meeting, the sender of an email).
RELAY_GOOGLE_ACCOUNT=

# Where the OAuth token lives once `python -m relay.google_auth` has run.
RELAY_TOKEN_FILE=token.json

# Working hours offered when searching for a slot.
RELAY_DAY_START=09:00
RELAY_DAY_END=18:00

# Budgets from the build plan: the run stops rather than looping
RELAY_MAX_TOOL_CALLS=20
RELAY_MAX_REPLANS=2

# Timezone used to resolve phrases like "next week"
RELAY_TIMEZONE=Asia/Kolkata
